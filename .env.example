# Copy this file to .env and fill in what you need. Every setting is optional.

# Claude picks the clips when a key is set (paid, a few cents per video).
# Without a key the free local AI (Ollama) is used, and if that isn't running, a rule-based picker.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# OLLAMA_MODEL=qwen2.5:7b      # qwen2.5:3b if your GPU has less than 6 GB
# OLLAMA_URL=http://127.0.0.1:11434
# WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
# MUSICGEN_MODEL=facebook/musicgen-small
# FFMPEG_DIR=C:\ffmpeg\bin
# CLIPPER_JOBS_DIR=D:\clipper-jobs   # keep big video files out of synced folders like OneDrive
# CLIPPER_PORT=8765
